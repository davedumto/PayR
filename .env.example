# Copy to .env.local for local development. Never commit real values.

# Base URL of the Vellar x402 facilitator. Must be https (http allowed for localhost in tests only).
VELLAR_FACILITATOR_URL=https://facilitator.example.invalid

# Anthropic API key used by server-side Claude calls (not used in this scaffold).
ANTHROPIC_API_KEY=

# Model ID passed to the Anthropic API. Configurable; there is no default.
ANTHROPIC_MODEL=

# CONFIG store (seller configs), REST endpoint. Must be https.
KV_CONFIG_REST_API_URL=https://config-kv.example.invalid

# CONFIG store, read-only token. Edge uses this to read seller configs. Cannot write.
KV_CONFIG_READ_ONLY_TOKEN=

# CONFIG store, read-write token. Server only. Never exposed to Edge code.
KV_CONFIG_REST_API_TOKEN=

# STATE store (locks and rate counters), REST endpoint. Must be https.
KV_STATE_REST_API_URL=https://state-kv.example.invalid

# STATE store, read-write token. Edge uses this for replay locks and rate limits.
KV_STATE_REST_API_TOKEN=

# Key for the bootstrap agent that provisions Vellar accounts.
VELLAR_BOOTSTRAP_AGENT_KEY=

# Public: which Stellar network the UI labels and talks to. One of: testnet, mainnet.
NEXT_PUBLIC_VELLAR_NETWORK=testnet
